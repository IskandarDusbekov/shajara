# =============================================================================
#  e-Shajara вЂ” muhit sozlamalari (.env)
#
#  Serverda:   cp .env.example .env && chmod 600 .env   в†’ so'ng qiymatlarni to'ldiring
#  Kompyuterda (ishlab chiqish): .env shart emas вЂ” standart qiymatlar ishlaydi.
#              Kerak bo'lsa DJANGO_DEBUG=1 qilib shu faylni nusxalang.
#
#  .env git'ga qo'shilmaydi (.gitignore'da bor) вЂ” parollarni shu yerga yozing.
#  Qo'shtirnoq shart emas. Bo'sh qoldirilgan qiymat standart qiymatni oladi.
# =============================================================================


# ----------------------------------------------------------------- Django ---

# Maxfiy kalit вЂ” MAJBURIY (DEBUG=0 da bo'sh bo'lsa sayt ishga tushmaydi).
# Yangi kalit yaratish:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 0 = production (server). 1 = faqat o'z kompyuteringizda ishlab chiqish.
# Eslatma: systemd servisi baribir DJANGO_DEBUG=0 bilan ishga tushiradi.
DJANGO_DEBUG=0

# Sayt ochiladigan domenlar, vergul bilan.
DJANGO_ALLOWED_HOSTS=e-shajara.uz,www.e-shajara.uz

# Saytning asosiy manzili вЂ” kanonik havolalar, sitemap.xml va ulashish kartalari uchun.
SITE_URL=https://e-shajara.uz

# Formalar qabul qilinadigan manzillar. Bo'sh qoldirsangiz, yuqoridagi har bir
# domen uchun https://... avtomatik qo'shiladi вЂ” odatda shu yetarli.
DJANGO_CSRF_TRUSTED_ORIGINS=

# HTTP в†’ HTTPS yo'naltirish. certbot nginx'da o'zi yo'naltiradi, lekin 1 qolsin.
# Sertifikat olinmaguncha saytni http orqali sinamoqchi bo'lsangiz vaqtincha 0.
DJANGO_SSL_REDIRECT=1

# HSTS (brauzer saytni faqat https orqali ochishni eslab qoladi), soniya.
# Boshida 3600 (1 soat). HTTPS bir-ikki hafta muammosiz ishlasa 31536000 (1 yil).
DJANGO_HSTS_SECONDS=3600

# Loglar darajasi: WARNING (kam), INFO (odatiy), DEBUG (juda ko'p)
DJANGO_LOG_LEVEL=WARNING


# --------------------------------------------------- Fayllar joylashuvi ---
# Bo'sh qolsa loyiha papkasi ichida: db.sqlite3, media/, staticfiles/.
# nginx sozlamasi (deploy/nginx-e-shajara.conf) shu standart yo'llarga mos.
DJANGO_DB_PATH=
DJANGO_MEDIA_ROOT=
DJANGO_STATIC_ROOT=


# ------------------------------------------------------------------ Email ---
# Ro'yxatdan o'tishda tasdiqlash kodi va parolni tiklash kodi shu orqali boradi.
# EMAIL_HOST_USER bo'sh bo'lsa xat yuborilmaydi (kod faqat server logiga chiqadi),
# ya'ni production'da albatta to'ldiring.

# --- Gmail (tavsiya) ---------------------------------------------------------
# Oddiy parol ishlamaydi, "App password" kerak:
#   1. Google hisobida 2 bosqichli tasdiqlashni yoqing
#   2. https://myaccount.google.com/apppasswords вЂ” yangi parol yarating
#   3. 16 belgili parolni bo'sh joylarsiz quyiga yozing
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
# Masalan: EMAIL_HOST_USER=eshajara.uz@gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Xat kimdan kelgani. Gmail'da EMAIL_HOST_USER bilan bir xil manzil bo'lsin.
# Masalan: DEFAULT_FROM_EMAIL=e-Shajara <eshajara.uz@gmail.com>
DEFAULT_FROM_EMAIL=

# SMTP serverni kutish vaqti, soniya
EMAIL_TIMEOUT=15

# --- Brevo (spamga tushmaydi — eng yaxshi tanlov) ---------------------------------
# Gmail shaxsiy hisobdan yuborilgan avtomatik xatlar ko'pincha Spam'ga tushadi.
# Brevo (kuniga 300 ta bepul) o'z domeningiz nomidan yuboradi:
#   1. https://app.brevo.com da hisob oching -> Senders, Domains -> e-shajara.uz ni qo'shing
#   2. Brevo ko'rsatgan DNS yozuvlarini (SPF/DKIM/DMARC) domen panelingizga qo'shing va tasdiqlang
#   3. SMTP & API -> SMTP bo'limidan login va SMTP kalitini oling
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_HOST_USER=<Brevo SMTP login>
# EMAIL_HOST_PASSWORD=<Brevo SMTP kaliti>
# DEFAULT_FROM_EMAIL=e-Shajara <noreply@e-shajara.uz>
#
# Sinash: boshqaruv paneli -> Tizim holati -> «Test xat yuborish»

# --- Boshqa pochta xizmatlari (kerakli blokni yuqoridagi o'rniga qo'ying) ---
#
# Yandex:     EMAIL_HOST=smtp.yandex.com     EMAIL_PORT=465  EMAIL_USE_TLS=0  EMAIL_USE_SSL=1
# Mail.ru:    EMAIL_HOST=smtp.mail.ru        EMAIL_PORT=465  EMAIL_USE_TLS=0  EMAIL_USE_SSL=1
# Outlook:    EMAIL_HOST=smtp.office365.com  EMAIL_PORT=587  EMAIL_USE_TLS=1  EMAIL_USE_SSL=0
