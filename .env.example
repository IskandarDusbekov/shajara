# =============================================================================
#  e-Shajara — muhit sozlamalari (.env)
#
#  1) Shu faylni nusxalang:      cp .env.example .env
#     (Windows PowerShell:       Copy-Item .env.example .env)
#  2) .env ichidagi qiymatlarni o'zingiznikiga almashtiring.
#  3) Serverni qayta ishga tushiring.
#
#  .env git'ga qo'shilmaydi (.gitignore'da bor) — unga parol yozish xavfsiz.
#  Qo'shtirnoq shart emas. Bo'sh qoldirilgan qiymat standart qiymatni oladi.
# =============================================================================


# ----------------------------------------------------------------- Django ---

# Maxfiy kalit. Production'da ALBATTA o'zingiznikini yozing. Yangi kalit:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 1 = ishlab chiqish (xatolar sahifada ko'rinadi), 0 = production
DJANGO_DEBUG=1

# Sayt ochiladigan domenlar, vergul bilan.
# Productionda: e-shajara.uz,www.e-shajara.uz,eshajara.uz
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Forma yuboriladigan to'liq manzillar (https:// bilan), vergul bilan.
# ngrok yoki domen ishlatsangiz kerak. Masalan: https://e-shajara.uz,https://www.e-shajara.uz
DJANGO_CSRF_TRUSTED_ORIGINS=

# DJANGO_DEBUG=0 bo'lganda HTTP -> HTTPS yo'naltirish.
# nginx/ngrok o'zi yo'naltirsa 0 qiling.
DJANGO_SSL_REDIRECT=1


# ------------------------------------------------------------------ Email ---
# Ro'yxatdan o'tishda email tasdiqlash kodi (OTP) va parolni tiklash kodi
# shu orqali yuboriladi.
#
# EMAIL_HOST yoki EMAIL_HOST_USER bo'sh bo'lsa, xat yuborilmaydi — kod
# server terminaliga chiqadi. Ishlab chiqishda sinash uchun qulay.

# --- Gmail (tavsiya) ---------------------------------------------------------
# Oddiy parol ishlamaydi, "App password" kerak:
#   1. Google hisobida 2 bosqichli tasdiqlashni yoqing
#   2. https://myaccount.google.com/apppasswords sahifasida parol yarating
#   3. Chiqqan 16 belgili parolni bo'sh joylarsiz quyiga yozing
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
# Masalan: EMAIL_HOST_USER=aziz.karimov@gmail.com
#          EMAIL_HOST_PASSWORD=abcdabcdabcdabcd
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Xat kimdan kelgani ko'rinadi. Gmail'da EMAIL_HOST_USER bilan bir xil bo'lsin.
# Masalan: DEFAULT_FROM_EMAIL=e-Shajara <aziz.karimov@gmail.com>
DEFAULT_FROM_EMAIL=

# SMTP serverni kutish vaqti, soniya
EMAIL_TIMEOUT=15

# --- Boshqa pochta xizmatlari (kerakli blokni yuqoridagi o'rniga qo'ying) ---
#
# Yandex:
#   EMAIL_HOST=smtp.yandex.com
#   EMAIL_PORT=465
#   EMAIL_USE_TLS=0
#   EMAIL_USE_SSL=1
#
# Mail.ru:
#   EMAIL_HOST=smtp.mail.ru
#   EMAIL_PORT=465
#   EMAIL_USE_TLS=0
#   EMAIL_USE_SSL=1
#
# Outlook / Hotmail:
#   EMAIL_HOST=smtp.office365.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=1
#   EMAIL_USE_SSL=0
